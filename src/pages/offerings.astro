---
import Base from "../layouts/Base.astro";
import ComponentMatrix from "../components/ComponentMatrix.astro";
import { getCollection, getEntry, render } from "astro:content";
import { dialLabels } from "../data/components";

const page = await getEntry("pages", "offerings");
const offerings = (await getCollection("offerings")).sort(
  (a, b) => a.data.order - b.data.order,
);
const hero = page?.data.hero;
let PageBody: any = null;
if (page) {
  const { Content } = await render(page);
  PageBody = Content;
}
const offeringBodies = (
  await Promise.all(offerings.map((o) => render(o)))
).map((r) => r.Content);
---

<Base title={page?.data.title ?? "Offerings"} description={page?.data.description}>
  <section class="page-hero">
    <div class="wrap">
      {hero && <span class="kicker">{hero.kicker}</span>}
      <h1 class="riso" data-text={hero?.headline ?? "Offerings"}>
        {hero?.headline ?? "Offerings"}
      </h1>
      {hero?.sub && <p style="max-width:34em;font-size:1.2rem">{hero.sub}</p>}
      {PageBody && <div class="prose"><PageBody /></div>}
    </div>
  </section>

  <section class="section">
    <div class="wrap stack">
      <h2>The comparison</h2>
      <p class="muted">
        The same five components, configured two ways. This is the whole
        decision.
      </p>
      <ComponentMatrix />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Same core. Different last step.</h2>
      <p class="muted" style="max-width:36em">
        Every ConcertIM service runs the same process. Where it forks is who
        acts on it.
      </p>
      <div class="process" style="margin-top:clamp(1.5rem,4vw,2.5rem)">
        <div class="process__row">
          <div class="process__card">
            <p class="process__num">01</p>
            <p class="process__name">Watch</p>
            <p>Continuous collection of environment health. It never stops, wherever you sit on the dial.</p>
          </div>
          <div class="process__card">
            <p class="process__num">02</p>
            <p class="process__name">Report</p>
            <p>Grouped and readable — a report you can actually use, not a raw dump.</p>
          </div>
          <div class="process__card">
            <p class="process__num">03</p>
            <p class="process__name">Prioritise</p>
            <p>Weighted by what matters to <strong>your</strong> service, not a generic checklist.</p>
          </div>
          <div class="process__card">
            <p class="process__num">04</p>
            <p class="process__name">Recommend</p>
            <p>Each focus area becomes an observation: what we found, the likely impact if ignored, and the recommended action.</p>
          </div>
        </div>
        <div class="process__fork">
          <div class="process__fork-head">
            <p class="process__num">05</p>
            <p class="process__name">Address</p>
          </div>
          <div class="process__options">
            <div class="process__option process__option--passive">
              <p class="process__option-label">Passive Reporting</p>
              <p>Your call. Fix it yourself, or hand the observations back and we'll take it from there.</p>
            </div>
            <div class="process__option process__option--managed">
              <p class="process__option-label">Fully Managed</p>
              <p>We act. Instant (9–5) response, with the work tracked through to completion.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper-2-bg">
    <div class="wrap">
      <h2>The offerings</h2>
      {
        offerings.map((o, i) => {
          const Body = offeringBodies[i];
          return (
            <article class="offer-row">
              <div>
                <p class="offer-row__num">
                  {String(i + 1).padStart(2, "0")} / {dialLabels[o.data.dial]}
                </p>
                <h3 class="riso" data-text={o.data.label}>{o.data.label}</h3>
                <p style="font-family:var(--display);font-size:clamp(1.2rem,3vw,1.6rem);line-height:1;margin:0.3rem 0 0.8rem">
                  {o.data.oneLiner}
                </p>
                <p style="max-width:40em">{o.data.pitch}</p>
                <div class="prose">
                  <Body />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Base>